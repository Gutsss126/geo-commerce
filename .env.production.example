# FanCrafti 生产示例 — 复制为 .env 或填入托管平台环境变量

# SQLite 单机部署
DATABASE_URL="file:./prisma/prod.db"

# 或使用 PostgreSQL（Vercel / Railway 推荐）
# DATABASE_URL="postgresql://user:pass@host:5432/geo_commerce"

# 必须与浏览器/插件访问的 GEO 后台公网地址一致（HTTPS）
NEXT_PUBLIC_APP_URL="https://geo.fancrafti.com"
NEXT_PUBLIC_APP_NAME="GEO Commerce — FanCrafti"
